{
  "manifest_version": 3,
  "name": "学习通全能助手 (DeepSeek 版)",
  "version": "5.1.0",
  "description": "集成了智能排队刷课、视频倍速播放、自动翻阅图文PPT、无感跳过已完成任务与测验、自动答题及题库多格式导出等全能功能。",
  "icons": {
    "16": "icons/stack-of-books.png",
    "48": "icons/stack-of-books.png",
    "128": "icons/stack-of-books.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.erya100.com/*",
        "*://*.xuexitong.com/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "utils.js",
        "pagination.js",
        "ai-ui.js",
        "ui.js",
        "video.js",
        "doc.js",
        "scraper.js",
        "solver.js",
        "ai-solver.js",
        "main.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://api.deepseek.com/*"
  ]
}
